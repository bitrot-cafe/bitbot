# ---- Bootstrap: read once at startup, never changeable from chat ----
# Any VAR can instead be given as VAR_FILE=/path/to/file (Docker/compose secrets): the file's contents win.

# Bot token (secret). Prefer FLUXER_BOT_TOKEN_FILE in production.
FLUXER_BOT_TOKEN=
# Default command prefix (default !). Guilds can each choose their own with
# `!admin config set core prefix <prefix>` (per guild: coming); mentioning the bot always works too.
PREFIX=!
# Optional: self-hosted Fluxer instance, e.g. chat.example.com. Leave empty for fluxer.app.
FLUXER_INSTANCE=
# Optional: database. Default: sqlite:data/bitbot.db (SQLite file, fine for small communities).
# Postgres: postgres://user:password@host:5432/bitbot (holds a password: prefer DATABASE_URL_FILE).
DATABASE_URL=
# Optional: who administers the bot (roles root and admin). Default: permissions.yaml in the app folder;
# copy permissions.example.yaml. No file: only the application owner (as root).
PERMISSIONS_FILE=
# Optional: folder of plugins (default: ./plugins).
PLUGINS_DIR=

# ---- Everything else is a setting in the database ----
# Change settings from chat with `!admin config` (bot admins), e.g.
#   !admin config core                         list core settings
#   !admin config set core log_channel <id>    channel for notices/warnings/errors
#   !admin config set core status {prefix}help | hi   (outer quotes, if any, are dropped)
#   !admin config access-sync                  a plugin's settings
# A setting's environment variable still works and wins over the database (BOT_STATUS, LOG_CHANNEL_ID,
# DEBUG, HELP_PAGE_PATH, HELP_URL, and each plugin's own; see `!admin config <scope>`).
# Secrets (tokens, passwords) are never stored in the database: set them here or via *_FILE.
