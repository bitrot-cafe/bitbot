# /opt/bitbot/.env: bootstrap settings (chown root:docker, chmod 660).
# Secrets are NOT here: they're files in /opt/bitbot/secrets/ (see compose.yaml and README.md).
PREFIX=!
FLUXER_INSTANCE=chat.bitrot.cafe
# Who administers the bot is in permissions.yaml (staff: true there replaces TRUST_INSTANCE_STAFF).

# Everything else lives in the database and is changed from chat with `!admin config`, e.g.
#   !admin config set core log_channel <channel id>
#   !admin config set access-sync guild_id 1562114954234953728
#   !admin config set access-sync role_id 1570188870010535936
#   !admin config set access-sync nextcloud_url https://cloud.example
#   !admin config set access-sync dry_run false        (when ready to go live)
#
# Plugin secrets come from the environment, e.g. the access-sync app password:
#   ACCESS_SYNC_NEXTCLOUD_APP_PASSWORD_FILE=/run/secrets/nextcloud_app_password   (add it to compose.yaml's secrets)
