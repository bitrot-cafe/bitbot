# /opt/bitbot/.env: copy to .env, fill in, chown root:docker, chmod 660.
# Core settings (see the main .env.example for descriptions).
FLUXER_BOT_TOKEN=
PREFIX=!
# Optional: self-hosted Fluxer instance, e.g. chat.example.com. Leave empty for fluxer.app.
FLUXER_INSTANCE=chat.bitrot.cafe
# Optional: bot status. Placeholders {prefix} and {guilds}. Default: {prefix}help | Live in {guilds} guilds
BOT_STATUS=
# Optional: treat instance staff (users with the Staff badge) as bot administrators. Off by default;
# leave off on fluxer.app, where Staff means Fluxer employees.
TRUST_INSTANCE_STAFF=true
# Optional: debug mode at startup (also toggled at runtime with !admin debug on|off).
# Shows debug logs and includes error details in replies. Leave off in public guilds.
DEBUG=
# Optional: channel ID that receives warnings and errors. Use a private channel.
LOG_CHANNEL_ID=
# Optional: write a static HTML command list here at startup (e.g. public/help.html), for a web server to host.
HELP_PAGE_PATH=public/help.html
# Optional: public URL of that page; !help links to it.
HELP_URL=

# ---- Plugin: access-sync (see plugins/access-sync/README.md) ----
CENTRAL_GUILD_ID=1562114954234953728
NC_ROLE_ID=1570188870010535936
NEXTCLOUD_URL=
NEXTCLOUD_USER=fluxer-sync
NEXTCLOUD_APP_PASSWORD=
ACCESS_SYNC_INTERVAL_MIN=60
ACCESS_SYNC_DRY_RUN=true
