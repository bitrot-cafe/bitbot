    "better-sqlite3": "^13.0.3",
    "kysely": "^0.29.8",
    "pg": "^8.23.1",
    "tsx": "4.23.15",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
